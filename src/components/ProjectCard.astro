---
import type { Project } from '../data/resume';
import { url } from '../lib/paths';

interface Props {
  project: Project;
  index: number;
  lead?: boolean;
}
const { project: p, index, lead = false } = Astro.props;
const detailId = `detail-${p.slug}`;
---

<article class:list={['project', lead && 'project--lead']} id={`p-${p.slug}`}>
  <div class="project__top">
    <span class="index">{String(index + 1).padStart(2, '0')}</span>
    <div class="project__id">
      <h3>{p.title}</h3>
      <p class="project__tagline">{p.tagline}</p>
    </div>
    <span class="project__period mono">{p.period.replace('-', ' – ')}</span>
  </div>
  <p class="project__meta"><span class="label">角色</span>{p.role}</p>
  <p class="project__summary">{p.summary}</p>
  <div class="project__stack">
    {p.stack.map((t) => <span class="chip">{t}</span>)}
  </div>

  <div class="project__bar">
    <button class="toggle" type="button" aria-expanded="false" aria-controls={detailId}>
      <span class="toggle__text">查看详情</span>
      <svg class="toggle__icon" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
        <path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <span class="project__hint">
      {p.highlights.length} 条要点{p.links?.length ? ` · ${p.links.length} 个链接` : ''}
    </span>
    <a class="project__more" href={url(`/projects/${p.slug}`)}>详情页 →</a>
  </div>

  <div class="project__details" id={detailId}>
    <div class="project__details-inner">
      <div class="project__highlights">
        {p.highlights.map((h) => (
          <div class="hl">
            <h4>{h.title}</h4>
            <p>{h.body}</p>
          </div>
        ))}
      </div>
      <ul class="value">
        {p.value.map((v) => <li>{v}</li>)}
      </ul>
      {p.links?.length && (
        <div class="project__links">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noreferrer">{l.label} ↗</a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>
